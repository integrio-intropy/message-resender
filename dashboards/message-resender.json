{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" },
    { "type": "panel", "id": "stat", "name": "Stat" },
    { "type": "panel", "id": "gauge", "name": "Gauge" },
    { "type": "panel", "id": "timeseries", "name": "Time series" },
    { "type": "panel", "id": "barchart", "name": "Bar chart" },
    { "type": "panel", "id": "table", "name": "Table" }
  ],
  "uid": "message-resender",
  "title": "Message Resender",
  "description": "DLQ drain metrics for the message-resender operator",
  "tags": ["message-resender", "operator", "dlq"],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Messages Resent (24h)",
      "description": "Total messages successfully republished in the last 24 hours",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "text", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(resend_messages_succeeded_total{host=~\"$host\"}[24h]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Messages Failed (24h)",
      "description": "Total messages that failed to republish in the last 24 hours",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(resend_messages_failed_total{host=~\"$host\"}[24h]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Success Rate (1h)",
      "description": "Percentage of processed messages that were successfully republished",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(resend_messages_succeeded_total{host=~\"$host\"}[1h])) / clamp_min(sum(increase(resend_messages_processed_total{host=~\"$host\"}[1h])), 1) * 100",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Queues",
      "description": "Number of queues that have been drained recently",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "text", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "count(resend_last_run_timestamp_seconds{host=~\"$host\"} > 0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg Drain Duration",
      "description": "Average drain duration across all queues over the last hour",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(resend_run_duration_seconds_sum{host=~\"$host\"}[$__rate_interval])) / clamp_min(sum(rate(resend_run_duration_seconds_count{host=~\"$host\"}[$__rate_interval])), 1e-10)",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest Run",
      "description": "Time since the oldest last-run across all queues — alerts to stalled drains",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 900 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "max(time() - resend_last_run_timestamp_seconds{host=~\"$host\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "row",
      "title": "Messages",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages Resent / min",
      "description": "Rate of successfully republished messages per queue",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "stacking": { "mode": "normal" },
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(resend_messages_succeeded_total{queue=~\"$queue\", host=~\"$host\"}[$__rate_interval]) * 60",
          "legendFormat": "{{ queue }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Messages / min",
      "description": "Rate of messages that failed to republish per queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "stacking": { "mode": "normal" },
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "cpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(resend_messages_failed_total{queue=~\"$queue\", host=~\"$host\"}[$__rate_interval]) * 60",
          "legendFormat": "{{ queue }}"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top Queues by Volume (24h)",
      "description": "Queues ranked by total messages resent in the last 24 hours",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "stacking": "none",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" }
      },
      "transformations": [
        { "id": "sortBy", "options": { "sort": [{ "field": "Value", "desc": true }] } },
        { "id": "limit", "options": { "limitField": 15 } }
      ],
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(15, sum by (queue) (increase(resend_messages_succeeded_total{host=~\"$host\"}[24h])))",
          "legendFormat": "{{ queue }}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processed vs Succeeded vs Failed",
      "description": "Aggregate message counts across all queues",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": { "mode": "none" },
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "cpm"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "succeeded" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "processed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(resend_messages_processed_total{host=~\"$host\"}[$__rate_interval])) * 60",
          "legendFormat": "processed"
        },
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(resend_messages_succeeded_total{host=~\"$host\"}[$__rate_interval])) * 60",
          "legendFormat": "succeeded"
        },
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(resend_messages_failed_total{host=~\"$host\"}[$__rate_interval])) * 60",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "type": "row",
      "title": "Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Drain Duration by Queue",
      "description": "Average drain duration per queue over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(resend_run_duration_seconds_sum{queue=~\"$queue\", host=~\"$host\"}[$__rate_interval]) / clamp_min(rate(resend_run_duration_seconds_count{queue=~\"$queue\", host=~\"$host\"}[$__rate_interval]), 1e-10)",
          "legendFormat": "{{ queue }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Drain Duration by Queue",
      "description": "95th percentile drain duration per queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (queue, le) (rate(resend_run_duration_seconds_bucket{queue=~\"$queue\", host=~\"$host\"}[$__rate_interval])))",
          "legendFormat": "{{ queue }}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Queue Status",
      "description": "Per-queue health overview: last run age, total counts, success rate, and average duration",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Queue" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Run Age" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 600 }, { "color": "red", "value": 900 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Succeeded (24h)" },
            "properties": [{ "id": "unit", "value": "short" }]
          },
          {
            "matcher": { "id": "byName", "options": "Failed (24h)" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Success Rate" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.9 }, { "color": "green", "value": 0.99 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg Duration" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Succeeded (24h)", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "queue" } },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "queue": "Queue",
              "Value #A": "Last Run Age",
              "Value #B": "Succeeded (24h)",
              "Value #C": "Failed (24h)",
              "Value #D": "Success Rate",
              "Value #E": "Avg Duration"
            },
            "excludeByName": { "Time": true, "host": true, "Time #A": true, "Time #B": true, "Time #C": true, "Time #D": true, "Time #E": true }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "time() - resend_last_run_timestamp_seconds{host=~\"$host\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (queue) (increase(resend_messages_succeeded_total{host=~\"$host\"}[24h]))",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (queue) (increase(resend_messages_failed_total{host=~\"$host\"}[24h]))",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (queue) (increase(resend_messages_succeeded_total{host=~\"$host\"}[24h])) / clamp_min(sum by (queue) (increase(resend_messages_processed_total{host=~\"$host\"}[24h])), 1)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": { "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (queue) (rate(resend_run_duration_seconds_sum{host=~\"$host\"}[1h])) / clamp_min(sum by (queue) (rate(resend_run_duration_seconds_count{host=~\"$host\"}[1h])), 1e-10)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(resend_messages_processed_total, host)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": { "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(resend_messages_processed_total{host=~\"$host\"}, queue)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser"
}
